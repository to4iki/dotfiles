theme = Catppuccin Mocha
macos-option-as-alt = true

# Window
macos-titlebar-style = tabs
macos-window-shadow = false
window-width = 150
window-height = 70

# Font
font-family = "SF Mono"
font-family = "Hiragino Sans"
font-size = 12
font-thicken = true

# Shell
shell-integration-features = no-cursor

# Cursor
cursor-style = block
cursor-style-blink = false

# Keybind
keybind = shift+enter=text:\x1b\r

# herdr: cmd chords -> prefix (ctrl+t) + key
keybind = cmd+up=text:\x14\x1b[A
keybind = cmd+down=text:\x14\x1b[B
keybind = cmd+[=text:\x14p
keybind = cmd+]=text:\x14n
keybind = cmd+t=text:\x14c
keybind = cmd+n=text:\x14N
keybind = cmd+b=text:\x14b
keybind = cmd+o=text:\x14o
keybind = cmd+u=text:\x14u
